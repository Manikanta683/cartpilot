# Copy to .env and fill in. TEST keys only — never real money, never commit this file.
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
CARTPILOT_DB=cartpilot.db
CARTPILOT_STUB=true
# Brain: stub (default, no keys) or claude (needs ANTHROPIC_API_KEY + Claude Code CLI)
CARTPILOT_BRAIN=stub
# Backend: mock (default, in-memory) or razorpay (real test-mode REST, needs keys below)
CARTPILOT_BACKEND=mock
# Optional: override the Claude model used by the claude brain
CARTPILOT_MODEL=
